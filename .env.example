# Vercel AI Gateway (preferred scorer) — GitHub Actions + local bot
AI_GATEWAY_API_KEY=
AI_GATEWAY_MODEL=google/gemini-3.1-flash-lite

# Optional Gemini fallback
GEMINI_API_KEY=

# Alerts (subscribe in the ntfy app)
NTFY_TOPIC=

# Optional: path to vinted CLI (defaults to sibling vinted-mcp-cli, then npx)
# VINTED_BIN=/path/to/vinted-mcp-cli/dist/cli.js

# --- Vercel dashboard (Project → Settings → Environment Variables) ---
# GitHub PAT with repo + actions:write (or fine-grained: contents read, actions write)
GITHUB_TOKEN=
# e.g. rolki-png/vinted-stuffs
GITHUB_REPO=
GITHUB_REF=main
GITHUB_WORKFLOW=vinted-bot.yml
# Shared secret for Run hunt / Full sweep buttons
# Optional: Vercel Cron auth (Dashboard creates CRON_SECRET automatically on Pro)
CRON_SECRET=

# CockroachDB Basic (score cache). Prefer DATABASE_URL; COCKROACH_DATABASE_URL also works.
# Never commit the real URL. Local: .env (gitignored). CI + Vercel: secret DATABASE_URL.
# Dashboard /api/dashboard live-reads scored_listings when this is set.
# One-time CA: curl --create-dirs -o $HOME/.postgresql/root.crt 'https://cockroachlabs.cloud/clusters/<id>/cert'
DATABASE_URL=
# COCKROACH_DATABASE_URL=
