{
  "name": "vinted-stuffs",
  "private": true,
  "type": "module",
  "imports": {
    "#/*": "./src/*"
  },
  "scripts": {
    "dev": "vite dev --port 3000",
    "generate-routes": "tsr generate",
    "build": "vite build",
    "preview": "vite preview",
    "lint": "eslint",
    "format": "prettier --write . && eslint --fix",
    "check": "prettier --check .",
    "test": "node scripts/assert-no-react-void-meta.mjs && node scripts/test-github-contents-json.mjs && node scripts/test-active-watches.mjs && cd python && python3 -m unittest discover -s tests -v",
